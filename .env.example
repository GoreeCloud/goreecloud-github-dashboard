# Non-secret configuration safe for the public/open-source repository.
GITHUB_OWNER=GoreeCloud

# Deployment safety interlock. Set to true only after the deployed site is
# protected by an authenticated private-access layer such as Cloudflare Access.
ACCESS_GATE_CONFIRMED=false

# Secret: configure in Cloudflare Pages/Workers secret storage or local .dev.vars.
# Never commit a real value to this public repository.
GITHUB_TOKEN=
